Navier.Analysis.CriticalMildEnergyEvolution.hasDerivAt_mild_rawHighSpectralEnergy (μ : ℝ) (hμ : 0 < μ)
  (a : ↥Navier.Analysis.CriticalMildWeightedBanach.WeightedLatticeBanach)
  (ha : Navier.Analysis.CriticalMildDuhamelBochner.LatticeDivergenceFree a)
  (A : ℝ → ↥Navier.Analysis.CriticalMildWeightedBanach.WeightedLatticeBanach) (hAc : Continuous A)
  (hdiv : ∀ (s : ℝ), Navier.Analysis.CriticalMildDuhamelBochner.LatticeDivergenceFree (A s)) {R T t N : ℝ} (hR : 0 ≤ R)
  (hN : 0 ≤ N) (ht : t ∈ Set.Ioo 0 T) (hbound : ∀ s ∈ Set.Ioc 0 T, ‖A s‖ ≤ R)
  (hmild :
    ∀ (s : ℝ) (hs : s ∈ Set.Icc 0 T), A s = Navier.Analysis.CriticalMildSelfMap.criticalMildImage μ hμ a A hdiv s ⋯) :
  HasDerivAt (fun s => Navier.Analysis.PhysicalPeriodicHighTailFlux.rawHighSpectralEnergy N (A s))
    (∑' (k : Navier.Analysis.CriticalMildSeries.LatticeMode),
      Navier.Analysis.RawHighEnergyDifferentiation.rawHighModeEnergyRate N (A t)
        (Navier.Analysis.CriticalMildModeDifferentiation.mildRawTimeDerivative μ A t) k)
    t

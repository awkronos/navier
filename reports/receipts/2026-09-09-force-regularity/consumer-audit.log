Navier.Breakdown.ConstructedBreakdown.wholeSpaceBreakdown : Navier.ProblemStatements.WholeSpaceBreakdown
Navier.Breakdown.ConstructedBreakdown.selectedFiniteEnergyCandidate :
  ∃ u p f,
    Navier.Construction.R3CompactCandidate.Properties u p f ∧
      ContDiff ℝ (↑⊤) f ∧ Navier.ConstructionR3.ProblemStatement.UniformFiniteEnergy (Set.Ico 0 1) u
Navier.Analysis.ConstructedFiniteTimeObstruction.selected_force_has_compact_physical_support :
  ∃ u p f K T,
    Navier.Construction.R3CompactCandidate.Properties u p f ∧
      ContDiff ℝ (↑⊤) f ∧
        Navier.ConstructionR3.ProblemStatement.UniformFiniteEnergy (Set.Ico 0 1) u ∧
          IsCompact K ∧
            0 ≤ T ∧
              Navier.Construction.CompactSpatialForceDecay.SupportedIn K f ∧
                ∀ (t : ℝ), T ≤ t → ∀ (x : Navier.Analysis.ConstructedFiniteTimeObstruction.ESpace✝), f (t, x) = 0
Navier.Analysis.ConstructedFiniteTimeObstruction.selected_candidate_forces_speed_blowup_in_every_smooth_competitor :
  ∃ u p f,
    Navier.Construction.R3CompactCandidate.Properties u p f ∧
      ContDiff ℝ (↑⊤) f ∧
        Navier.ConstructionR3.ProblemStatement.UniformFiniteEnergy (Set.Ico 0 1) u ∧
          ∀ (v : Navier.Analysis.ConstructedFiniteTimeObstruction.EVelocityField✝)
            (q : Navier.Analysis.ConstructedFiniteTimeObstruction.EPressureField✝),
            ContDiffOn ℝ (↑⊤) v Navier.Construction.ProblemStatement.preSingularDomain →
              ContDiffOn ℝ (↑⊤) q Navier.Construction.ProblemStatement.preSingularDomain →
                (∀ T ∈ Set.Ico 0 1, Navier.ConstructionR3.ProblemStatement.UniformFiniteEnergy (Set.Icc 0 T) v) →
                  (∀ t ∈ Set.Ioo 0 1,
                      ∀ (x : Navier.Construction.ProblemStatement.Space),
                        Navier.Construction.ProblemStatement.spatialDivergence v t x = 0) →
                    (∀ t ∈ Set.Ioo 0 1,
                        ∀ (x : Navier.Construction.ProblemStatement.Space),
                          Navier.Construction.ProblemStatement.navierStokesResidual v q t x = f (t, x)) →
                      (∀ (x : Navier.Construction.ProblemStatement.Space), v (0, x) = 0) →
                        Navier.Construction.ProblemStatement.SpeedUnboundedAtOne v
Navier.Analysis.ConstructedFiniteTimeObstruction.selected_force_nonzero_before_one :
  ∃ u p f,
    Navier.Construction.R3CompactCandidate.Properties u p f ∧
      ContDiff ℝ (↑⊤) f ∧
        Navier.ConstructionR3.ProblemStatement.UniformFiniteEnergy (Set.Ico 0 1) u ∧
          ∃ t ∈ Set.Ioo 0 1, ∃ x, f (t, x) ≠ 0
Navier.Analysis.ConstructedFiniteTimeObstruction.selected_candidate_excludes_locally_finite_energy_continuation :
  ∃ u p f K,
    Navier.Construction.R3CompactCandidate.Properties u p f ∧
      ContDiff ℝ (↑⊤) f ∧
        Navier.ConstructionR3.ProblemStatement.UniformFiniteEnergy (Set.Ico 0 1) u ∧
          IsCompact K ∧
            (∀ t ∈ Set.Ico 0 1, ∀ x ∉ K, u (t, x) = 0) ∧
              ¬∃ v q,
                  ContDiffOn ℝ (↑⊤) v Navier.Construction.ProblemStatement.preSingularDomain ∧
                    ContDiffOn ℝ (↑⊤) q Navier.Construction.ProblemStatement.preSingularDomain ∧
                      ContinuousOn v (Set.Icc 0 1 ×ˢ K) ∧
                        (∀ T ∈ Set.Ico 0 1,
                            Navier.ConstructionR3.ProblemStatement.UniformFiniteEnergy (Set.Icc 0 T) v) ∧
                          (∀ t ∈ Set.Ioo 0 1,
                              ∀ (x : Navier.Construction.ProblemStatement.Space),
                                Navier.Construction.ProblemStatement.spatialDivergence v t x = 0) ∧
                            (∀ t ∈ Set.Ioo 0 1,
                                ∀ (x : Navier.Construction.ProblemStatement.Space),
                                  Navier.Construction.ProblemStatement.navierStokesResidual v q t x = f (t, x)) ∧
                              ∀ (x : Navier.Construction.ProblemStatement.Space), v (0, x) = 0

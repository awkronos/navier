Navier.Analysis.PhysicalPeriodicHighEnergyBootstrap.exists_mild_highEnergy_decay_add_explicitBootstrap (mu : ℝ)
  (hmu : 0 < mu) (a0 : ↥Navier.Analysis.CriticalMildWeightedBanach.WeightedLatticeBanach)
  (ha0 : Navier.Analysis.CriticalMildDuhamelBochner.LatticeDivergenceFree a0)
  (A : ℝ → ↥Navier.Analysis.CriticalMildWeightedBanach.WeightedLatticeBanach) (hAc : Continuous A)
  (hdiv : ∀ (s : ℝ), Navier.Analysis.CriticalMildDuhamelBochner.LatticeDivergenceFree (A s)) {R delta T N : ℝ}
  (hR : 0 ≤ R) (hdelta : 0 < delta) (hdeltaT : delta ≤ T) (hN : 0 < N) (hbound : ∀ s ∈ Set.Ioc 0 T, ‖A s‖ ≤ R)
  (hmild :
    ∀ (s : ℝ) (hs : s ∈ Set.Icc 0 T),
      A s = Navier.Analysis.CriticalMildSelfMap.criticalMildImage mu hmu a0 A hdiv s ⋯) :
  ∃ b0,
    0 < b0 ∧
      b0 < delta ∧
        delta - b0 ≤ 1 ∧
          √(delta - b0) < b0 ∧
            ∀ t ∈ Set.Icc delta T,
              Navier.Analysis.PhysicalPeriodicHighTailFlux.rawHighSpectralEnergy N (A t) ≤
                Real.exp (-(2 * mu * N ^ 2) * (t - delta)) *
                    Navier.Analysis.PhysicalPeriodicHighTailFlux.rawHighSpectralEnergy N (A delta) +
                  4 * R ^ 2 *
                      Navier.Analysis.CriticalMildLocalUniformBootstrap.compactHalfGeneratorBudget mu a0 R delta b0 T /
                    (mu * N ^ 3)

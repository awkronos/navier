Navier.Analysis.CriticalMildHigherUniformMoments.exists_uniform_all_iteratedHalfOrder_on_compactPositiveInterval (ν : ℝ)
  (hν : 0 < ν) (u₀ : ↥Navier.Analysis.CriticalMildWeightedBanach.WeightedLatticeBanach)
  (hu₀ : Navier.Analysis.CriticalMildDuhamelBochner.LatticeDivergenceFree u₀)
  (u : ℝ → ↥Navier.Analysis.CriticalMildWeightedBanach.WeightedLatticeBanach) (huc : Continuous u)
  (hu : ∀ (x : ℝ), Navier.Analysis.CriticalMildDuhamelBochner.LatticeDivergenceFree (u x)) {R a T : ℝ} (hR : 0 ≤ R)
  (ha : 0 < a) (haT : a ≤ T) (huR : ∀ x ∈ Set.Ioc 0 T, ‖u x‖ ≤ R)
  (hmild :
    ∀ (x : ℝ) (hx : x ∈ Set.Icc 0 T), u x = Navier.Analysis.CriticalMildSelfMap.criticalMildImage ν hν u₀ u hu x ⋯) :
  ∃ B,
    (∀ (n : ℕ), 0 ≤ B n) ∧
      ∀ (n : ℕ),
        ∀ t ∈ Set.Icc a T,
          Navier.Analysis.CriticalMildPolynomialMomentConvolution.LatticePolynomialMoment
              (Navier.Analysis.CriticalMildHigherUniformMoments.iteratedHalfOrder 2 n) (u t) ∧
            Navier.Analysis.CriticalMildPolynomialMomentConvolution.polynomialMoment
                (Navier.Analysis.CriticalMildHigherUniformMoments.iteratedHalfOrder 2 n) (u t) ≤
              B n

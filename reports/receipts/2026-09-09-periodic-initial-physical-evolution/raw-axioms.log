Navier.Analysis.PeriodicInitialPhysicalEvolution.exists_physical_local_evolution_of_periodicInitialDatum (ν : ℝ)
  (hν : 0 < ν) (u₀ : Navier.VelocityField) (hu₀ : Navier.PeriodicInitialDatum u₀) :
  ∃ T,
    0 < T ∧
      ∃ A,
        A 0 = Navier.Analysis.PeriodicMildClassicalRealization.rawInitialCarrier u₀ hu₀ ∧
          Navier.Analysis.PeriodicMildClassicalRealization.physicalMildVelocity A 0 = u₀ ∧
            Continuous A ∧
              (∀ (s : ℝ), Navier.Analysis.CriticalMildDuhamelBochner.LatticeDivergenceFree (A s)) ∧
                (∀ (s : ℝ), Navier.Analysis.PeriodicMildClassicalRealization.LatticeAntiHermitian (A s)) ∧
                  (∀ (s : ℝ),
                      ‖A s‖ ≤
                        Navier.Analysis.CriticalMildQuantitativeRestart.criticalMildBoundedRadius
                          ‖Navier.Analysis.PeriodicMildClassicalRealization.rawInitialCarrier u₀ hu₀‖) ∧
                    (∀ t ∈ Set.Ioo 0 T,
                        (Summable fun k =>
                            Navier.Analysis.CriticalMildHigherMomentBootstrap.quarterFrequencyWeight k *
                              (‖Navier.Analysis.OfficialABEncoding.officialEuclideanPoint
                                      (Navier.Analysis.CriticalMildSeries.latticeFrequency k)‖ ^
                                  2 *
                                Navier.Analysis.ComplexLerayNorm.complexEuclideanNorm
                                  (Navier.Analysis.CriticalMildWeightedBanach.weightedLatticeCoefficient
                                    (Navier.Analysis.PeriodicMildClassicalRealization.physicalCarrier (A t)) k))) ∧
                          (∀ (k : Navier.Analysis.CriticalMildSeries.LatticeMode) (i : Fin 3),
                              HasDerivAt
                                (fun r =>
                                  Navier.Analysis.CriticalMildWeightedBanach.weightedLatticeCoefficient (A r) k i)
                                (Navier.Analysis.CriticalMildModeDifferentiation.mildRawTimeDerivative
                                  (Navier.Analysis.PeriodicMildClassicalRealization.rawMildViscosity ν) A t k i)
                                t) ∧
                            (Summable fun k =>
                                Navier.Analysis.ComplexLerayNorm.complexEuclideanNorm
                                  (Navier.Analysis.CriticalMildModeDifferentiation.mildRawTimeDerivative
                                    (Navier.Analysis.PeriodicMildClassicalRealization.rawMildViscosity ν) A t k)) ∧
                              ∀ (k : Navier.Analysis.CriticalMildSeries.LatticeMode),
                                Navier.Analysis.PeriodicMildClassicalRealization.rawToPhysicalAmplitude •
                                          Navier.Analysis.CriticalMildModeDifferentiation.mildRawTimeDerivative
                                            (Navier.Analysis.PeriodicMildClassicalRealization.rawMildViscosity ν) A t
                                            k +
                                        Navier.Analysis.PeriodicPressureRecovery.periodOneConvectionCoefficient k
                                          (Navier.Analysis.PeriodicMildClassicalRealization.physicalCarrier (A t))
                                          (Navier.Analysis.PeriodicMildClassicalRealization.physicalCarrier (A t)) +
                                      Navier.Analysis.PeriodicPressureRecovery.periodOneViscousCoefficient ν k
                                        (Navier.Analysis.CriticalMildWeightedBanach.weightedLatticeCoefficient
                                          (Navier.Analysis.PeriodicMildClassicalRealization.physicalCarrier (A t)) k) +
                                    Navier.Analysis.PeriodicPressureRecovery.periodOneGradientCoefficient k
                                      (Navier.Analysis.PeriodicPressureRecovery.periodOnePressureCoefficient k
                                        (Navier.Analysis.PeriodicMildClassicalRealization.physicalCarrier (A t))
                                        (Navier.Analysis.PeriodicMildClassicalRealization.physicalCarrier (A t))) =
                                  0) ∧
                      ∀ (n : ℕ),
                        Navier.Analysis.CriticalMildPolynomialMomentConvolution.LatticePolynomialMoment (↑n) (A 0)
'Navier.Analysis.PeriodicInitialPhysicalEvolution.exists_physical_local_evolution_of_periodicInitialDatum' depends on axioms: [propext,

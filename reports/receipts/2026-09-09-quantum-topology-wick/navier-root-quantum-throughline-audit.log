Navier.Analysis.QuantumVortexWinding.unitVortex_velocity_circulation :
  ∫ (theta : ℝ) in 0..2 * Real.pi,
      (star
            (Navier.Analysis.QuantumVortexRegularity.velocity Navier.Analysis.QuantumVortexRegularity.unitVortex
              (Navier.Analysis.QuantumVortexWinding.vortexPhase 1 theta)) *
          Navier.Analysis.QuantumVortexWinding.vortexPhaseDerivative 1 theta).re =
    2 * Real.pi
Navier.Analysis.QuantumVortexWinding.realChargePhase_closes_iff_integer (kappa : ℝ) :
  Navier.Analysis.QuantumVortexWinding.realChargePhase kappa (2 * Real.pi) =
      Navier.Analysis.QuantumVortexWinding.realChargePhase kappa 0 ↔
    ∃ n, kappa = ↑n

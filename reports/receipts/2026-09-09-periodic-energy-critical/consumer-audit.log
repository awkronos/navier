Navier.Analysis.CriticalMildZeroMode.CriticalMildOffZeroTerminalBound (ν : ℝ) (hν : 0 < ν)
  (a : ↥Navier.Analysis.CriticalMildWeightedBanach.WeightedLatticeBanach) (K : ℝ) : Prop
Navier.Analysis.CriticalMildZeroMode.exists_cofinal_global_mild_of_offZero (ν : ℝ) (hν : 0 < ν)
  (a : ↥Navier.Analysis.CriticalMildWeightedBanach.WeightedLatticeBanach) (K : ℝ) (hK : 0 ≤ K)
  (hoff : Navier.Analysis.CriticalMildZeroMode.CriticalMildOffZeroTerminalBound ν hν a K) :
  ∃ chain,
    chain.CofinalLifespan ∧
      ∀ (t : ℝ) (ht : 0 ≤ t),
        chain.totalExtension t =
          Navier.Analysis.CriticalMildSelfMap.criticalMildImage ν hν a chain.totalExtension ⋯ t ht
Navier.Analysis.PeriodicEnergyCriticalObstruction.low_add_high_X1_eq
  (S : Finset Navier.Analysis.CriticalMildSeries.LatticeMode)
  (u : ↥Navier.Analysis.CriticalMildWeightedBanach.WeightedLatticeBanach) :
  Navier.Analysis.PeriodicEnergyCriticalObstruction.lowX1On S u +
      Navier.Analysis.PeriodicEnergyCriticalObstruction.highX1Outside S u =
    Navier.Analysis.LeiLinSpace.normX1 Navier.Analysis.LeiLinCoerciveTerminal.latticeModeSize
      (Navier.Analysis.LeiLinCoerciveTerminal.weightedAmplitude u)
Navier.Analysis.PeriodicEnergyCriticalObstruction.normX1_le_frequencyCost_mul_energy_add_high
  (S : Finset Navier.Analysis.CriticalMildSeries.LatticeMode)
  (u : ↥Navier.Analysis.CriticalMildWeightedBanach.WeightedLatticeBanach) :
  Navier.Analysis.LeiLinSpace.normX1 Navier.Analysis.LeiLinCoerciveTerminal.latticeModeSize
      (Navier.Analysis.LeiLinCoerciveTerminal.weightedAmplitude u) ≤
    √(∑ m ∈ S, Navier.Analysis.LeiLinCoerciveTerminal.latticeModeSize m ^ 2) *
        √(∑ m ∈ S, Navier.Analysis.LeiLinCoerciveTerminal.weightedAmplitude u m ^ 2) +
      Navier.Analysis.PeriodicEnergyCriticalObstruction.highX1Outside S u

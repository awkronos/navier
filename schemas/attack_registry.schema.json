{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/navier/schemas/attack_registry.schema.json",
  "title": "Canonical Navier attack registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "registry_version",
    "registry_id",
    "base_revision",
    "generated_at",
    "ssot",
    "campaign",
    "barriers",
    "references",
    "approaches",
    "verifiers",
    "evidence",
    "obligations"
  ],
  "properties": {
    "$schema": {"const": "../schemas/attack_registry.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "registry_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"},
    "registry_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "base_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "ssot": {"const": true},
    "campaign": {"$ref": "#/$defs/campaign"},
    "barriers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/barrier"}
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/reference"}
    },
    "approaches": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/approach"}
    },
    "verifiers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/verifier"}
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/obligation"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 12,
      "pattern": ".*\\S.*"
    },
    "disposition": {
      "enum": ["CLOSED", "DECOMPOSED", "SCAFFOLDED", "RED", "FALSIFIED", "REVERTED"]
    },
    "claimTier": {
      "enum": ["SCAFFOLD", "THEOREM", "CONJECTURE", "EXPERIMENT", "FALSIFICATION"]
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "global_disposition",
        "scientific_status",
        "problem_surface",
        "resolution_mode",
        "resolution_obligation_ids"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"$ref": "#/$defs/nonEmptyText"},
        "summary": {"$ref": "#/$defs/nonEmptyText"},
        "global_disposition": {"$ref": "#/$defs/disposition"},
        "scientific_status": {"enum": ["SCIENTIFIC_FRONTIER", "CONDITIONAL_FRONTIER", "FORMALLY_RESOLVED"]},
        "problem_surface": {"$ref": "#/$defs/problemSurface"},
        "resolution_mode": {"const": "ANY"},
        "resolution_obligation_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "problemSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equation",
        "dimension",
        "geometry",
        "boundary",
        "viscosity",
        "viscosity_quantifier",
        "initial_data",
        "formal_path",
        "primary_branch",
        "resolution_branches"
      ],
      "properties": {
        "equation": {"const": "INCOMPRESSIBLE_NAVIER_STOKES"},
        "dimension": {"const": 3},
        "geometry": {"const": "R3"},
        "boundary": {"const": "NONE"},
        "viscosity": {"const": "POSITIVE"},
        "viscosity_quantifier": {"const": "FOR_EVERY_FIXED_POSITIVE"},
        "initial_data": {"const": "SMOOTH_DIVERGENCE_FREE_RAPID_DECAY"},
        "formal_path": {"const": "Navier/Problem.lean"},
        "primary_branch": {"const": "FEFFERMAN_A"},
        "resolution_branches": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/resolutionBranch"}
        }
      }
    },
    "resolutionBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "forcing", "target", "obligation_id", "public_declaration", "planned_formal_target"],
      "properties": {
        "id": {"enum": ["FEFFERMAN_A", "FEFFERMAN_C"]},
        "forcing": {"enum": ["ZERO", "SMOOTH_RAPID_DECAY"]},
        "target": {"enum": ["GLOBAL_SMOOTH_FINITE_ENERGY", "NO_GLOBAL_PHYSICALLY_REASONABLE_SOLUTION"]},
        "obligation_id": {"$ref": "#/$defs/identifier"},
        "public_declaration": {
          "oneOf": [
            {"type": "string", "pattern": "^Navier(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"},
            {"type": "null"}
          ]
        },
        "planned_formal_target": {
          "oneOf": [
            {"type": "string", "pattern": "^Navier(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"},
            {"type": "null"}
          ]
        }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equation",
        "dimension",
        "geometry",
        "boundary",
        "forcing",
        "viscosity",
        "viscosity_quantifier",
        "solution_class",
        "relation_to_endpoint",
        "endpoint_branch"
      ],
      "properties": {
        "equation": {"enum": ["INCOMPRESSIBLE_NAVIER_STOKES", "DISCRETE_NAVIER_STOKES", "AVERAGED_NAVIER_STOKES"]},
        "dimension": {"type": "integer", "minimum": 2, "maximum": 4},
        "geometry": {"enum": ["R3", "TORUS3", "BOUNDED_DOMAIN", "DISCRETE_GRID"]},
        "boundary": {"enum": ["NONE", "PERIODIC", "NO_SLIP", "DISCRETE"]},
        "forcing": {"enum": ["ZERO", "SMOOTH_RAPID_DECAY", "DISCRETE"]},
        "viscosity": {"enum": ["POSITIVE", "ZERO", "DISCRETE_POSITIVE"]},
        "viscosity_quantifier": {"enum": ["FOR_EVERY_FIXED_POSITIVE", "FIXED_DISCRETE_POSITIVE", "NOT_APPLICABLE"]},
        "solution_class": {"enum": ["EXACT_SMOOTH_FINITE_ENERGY", "CRITICAL_MILD", "SUITABLE_WEAK", "DISTRIBUTIONAL_WEAK", "DISCRETE_APPROXIMATION"]},
        "relation_to_endpoint": {"enum": ["EXACT", "PREREQUISITE", "STRONGER_THAN_C", "APPROXIMATION_ONLY", "ANALOGUE_ONLY"]},
        "endpoint_branch": {"enum": ["FEFFERMAN_A", "FEFFERMAN_C", "SHARED", "NONE"]}
      }
    },
    "barrier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "primary_reference_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"$ref": "#/$defs/nonEmptyText"},
        "description": {"$ref": "#/$defs/nonEmptyText"},
        "primary_reference_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "citation", "year", "locator", "relevance"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["PRIMARY", "SECONDARY"]},
        "citation": {"$ref": "#/$defs/nonEmptyText"},
        "year": {"type": "integer", "minimum": 1800, "maximum": 2100},
        "locator": {"type": "string", "minLength": 8},
        "relevance": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "barrierReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["barrier_id", "disposition", "rationale", "reference_ids"],
      "properties": {
        "barrier_id": {"$ref": "#/$defs/identifier"},
        "disposition": {"enum": ["ADDRESSED", "EXPOSED", "BLOCKED", "NOT_APPLICABLE"]},
        "rationale": {"$ref": "#/$defs/nonEmptyText"},
        "reference_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "approach": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "objective",
        "status",
        "transfer_mechanism",
        "primary_reference_ids",
        "barrier_reviews"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"$ref": "#/$defs/nonEmptyText"},
        "objective": {"$ref": "#/$defs/nonEmptyText"},
        "status": {"$ref": "#/$defs/disposition"},
        "transfer_mechanism": {
          "enum": [
            "DIRECT_THEOREM_APPLICATION",
            "MAP",
            "EQUIVALENCE",
            "FUNCTORIAL_TRANSPORT",
            "QUOTIENT_LOCALIZATION",
            "COMPLETION_LIMIT",
            "REALIZATION_PAYLOAD",
            "COMPUTATION_ONLY",
            "CONSTRUCTION",
            "NONE"
          ]
        },
        "primary_reference_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "barrier_reviews": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/barrierReview"}
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "command",
        "receipt_max_age_seconds",
        "closes_claim_tiers",
        "requires_axiom_audit",
        "allowed_axioms"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["REGISTRY", "UNIT_TEST", "LEAN_NATIVE", "Z3_NATIVE", "EXPERIMENT_REPLAY"]},
        "command": {"type": "string", "minLength": 8},
        "receipt_max_age_seconds": {"type": "integer", "minimum": 0},
        "closes_claim_tiers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/claimTier"}
        },
        "requires_axiom_audit": {"type": "boolean"},
        "allowed_axioms": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["propext", "Classical.choice", "Quot.sound", "native_decide"]}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "LEAN_NATIVE"}},
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "requires_axiom_audit": {"const": true},
              "closes_claim_tiers": {"contains": {"const": "THEOREM"}},
              "allowed_axioms": {
                "minItems": 3,
                "allOf": [
                  {"contains": {"const": "propext"}},
                  {"contains": {"const": "Classical.choice"}},
                  {"contains": {"const": "Quot.sound"}}
                ]
              }
            }
          },
          "else": {
            "properties": {
              "allowed_axioms": {"maxItems": 0}
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_locator", "source_revision", "immutable", "observed_at", "artifact_sha256"],
      "properties": {
        "source_locator": {"type": "string", "minLength": 5},
        "source_revision": {"type": "string", "minLength": 4},
        "immutable": {"type": "boolean"},
        "observed_at": {"type": "string", "format": "date-time"},
        "artifact_sha256": {
          "oneOf": [
            {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            {"type": "null"}
          ]
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier_id",
        "command",
        "exit_code",
        "result",
        "generated_at",
        "repository_revision",
        "declaration",
        "axioms",
        "artifact_sha256"
      ],
      "properties": {
        "verifier_id": {"$ref": "#/$defs/identifier"},
        "command": {"type": "string", "minLength": 8},
        "exit_code": {"type": "integer"},
        "result": {"enum": ["PASS", "FAIL"]},
        "generated_at": {"type": "string", "format": "date-time"},
        "repository_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "declaration": {"oneOf": [{"type": "string", "minLength": 3}, {"type": "null"}]},
        "axioms": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "claim_tier", "summary", "reference_ids", "supports", "provenance", "receipt"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["PRIMARY_REFERENCE_EVIDENCE", "NATIVE_RECEIPT", "EXPERIMENT_RECEIPT", "FALSIFICATION_WITNESS", "FORMAL_SURFACE_SNAPSHOT"]},
        "claim_tier": {"enum": ["REFERENCE", "THEOREM", "EXPERIMENT", "FALSIFICATION", "SCAFFOLD"]},
        "summary": {"$ref": "#/$defs/nonEmptyText"},
        "reference_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "supports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "provenance": {"$ref": "#/$defs/provenance"},
        "receipt": {
          "oneOf": [
            {"$ref": "#/$defs/receipt"},
            {"type": "null"}
          ]
        }
      }
    },
    "evidenceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "role"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/identifier"},
        "role": {"enum": ["BACKGROUND", "OBSERVATION", "REALIZATION", "FALSIFICATION"]}
      }
    },
    "residual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "smaller_than", "consumer_ids", "falsifier", "next_action"],
      "properties": {
        "statement": {"$ref": "#/$defs/nonEmptyText"},
        "smaller_than": {"$ref": "#/$defs/nonEmptyText"},
        "consumer_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "falsifier": {"$ref": "#/$defs/nonEmptyText"},
        "next_action": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "approach_id",
        "title",
        "kind",
        "claim_tier",
        "disposition",
        "statement",
        "formal_declaration",
        "dependency_mode",
        "dependencies",
        "assumption_ids",
        "domain",
        "reference_ids",
        "evidence_links",
        "verifier_ids",
        "barrier_ids",
        "residual"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "approach_id": {"$ref": "#/$defs/identifier"},
        "title": {"$ref": "#/$defs/nonEmptyText"},
        "kind": {"enum": ["DEFINITION", "LEMMA", "THEOREM", "BRIDGE", "PAYLOAD", "EXPERIMENT", "FALSIFICATION", "META", "ENDPOINT", "CONSTRUCTION"]},
        "claim_tier": {"$ref": "#/$defs/claimTier"},
        "disposition": {"$ref": "#/$defs/disposition"},
        "statement": {"$ref": "#/$defs/nonEmptyText"},
        "formal_declaration": {"oneOf": [{"type": "string", "minLength": 3}, {"type": "null"}]},
        "dependency_mode": {"enum": ["ALL", "ANY", "NONE"]},
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "assumption_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "domain": {"$ref": "#/$defs/domain"},
        "reference_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "evidence_links": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidenceLink"}
        },
        "verifier_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "barrier_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "residual": {
          "oneOf": [
            {"$ref": "#/$defs/residual"},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
